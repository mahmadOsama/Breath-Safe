# Firestore Database Configuration
FIREBASE_API_KEY=your_firestore_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_DATABASE_URL=your_database_url

# Realtime Database Configuration
REALTIME_API_KEY=your_realtime_api_key_here
REALTIME_AUTH_DOMAIN=your_realtime_project.firebaseapp.com
REALTIME_PROJECT_ID=your_realtime_project_id
REALTIME_STORAGE_BUCKET=your_realtime_project.firebasestorage.app
REALTIME_MESSAGING_SENDER_ID=your_realtime_sender_id
REALTIME_APP_ID=your_realtime_app_id
REALTIME_MEASUREMENT_ID=your_realtime_measurement_id
REALTIME_DATABASE_URL=your_realtime_database_url

# EmailJS Configuration
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Application Configuration
NODE_ENV=development
API_TIMEOUT=10000
LOG_LEVEL=debug