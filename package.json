{
  "name": "breathsafe",
  "version": "1.0.0",
  "description": "BreathSafe - Gas Leak Detection System",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-breathsafe \"node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.rules.config.js\"",
    "check:showcase": "node scripts/check-showcase-safety.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "eslint": "^8.50.0",
    "firebase-tools": "15.34.0",
    "jest": "30.5.2",
    "prettier": "^3.0.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
